-- Sharing metadata (25-community-and-ecosystem.md 3.2).  Read by tooling
-- and the manager detail pane; never by the loader's merge.
return {
  summary = "No Pokemon may out-level the next gym leader, Elite Four member or Champion.",
  author = "Pokemon Gen 1 Recompilation Project",
  contact = "https://github.com/bryanthaboi/gen1recomp",
  tags = { "challenge", "mechanic", "exp", "level-cap", "hardcore" },
  differences = {
    changed = {
      "LEVEL CAP on: a Pokemon at or above the cap gains no experience at all",
      "ALLOW OVER LVL NO: a trainer battle is refused outright while any party member is over the cap",
    },
    added = {
      "LEVEL CAP (OFF / STRICT / MILD UP2 / SOFT UP5 / EASY UP10) and ALLOW OVER LVL rows in OPTIONS",
      "on Gold: the eight Johto gyms, all seven rival fights, each Elite Four member separately, the Champion, Blue and Red -- 7/9/16/20/22/25/30/31/35/38/40/42/44/46/47/50/58/81 on vanilla data",
      "inside the league, a refused battle offers to send the over-levelled mons to the PC",
      "UP TO CAP in the party submenu: walks a Pokemon to the cap one level at a time, so no level-up move is skipped, with an evolution check at every threshold",
      "currentCap, nextMilestone, milestoneLevels and overLevelled exports for trackers and HUDs",
      "a nuzlocke_provider.level_caps export: with mods/nuzlocke installed, its tracker, Trainer Card and Gym Guide read this cap, and its own exp.gain wrapper steps aside so the two never compound. LEVEL CAP on OFF hands the mechanic back",
    },
    known = {
      "the caps are read from each trainer's real roster, so a mod that rebalances the gym curve moves them automatically; nothing here hard-codes 14/21/24/29/43/43/47/50/56/58/60/62/65",
      "Rare Candy is not blocked: it raises a level without ever going through the experience path",
      "UP TO CAP is free and instant by design; it exists so a fresh catch can join the team without grinding, not as a reward",
      "the UP TO CAP label is a raw English literal rather than a Strings() lookup, so a translation mod cannot reach it",
      "stat exp still accrues at the cap, because Experience.apply credits it before exp.gain is consulted",
      "wild battles are never refused, only trainer battles; a Pokemon Center PC is the way back under the cap outside the league",
      "the milestone-to-trainer map is fixed (OPP_BROCK ... OPP_RIVAL3 on Gen 1, FALKNER ... RED on Gold), so a total conversion with different leaders gets no caps rather than wrong ones",
      "needs engine_internals: no hook among the engine's 45 can veto a battle, so BattleState.newTrainer is patched at its single choke point",
      "Gold has no EVENT_BEAT_<LEADER> flag and none at all for the rival, so the mod records its own from battle.ended into save.modData; only rosters a milestone named are written, and the engine's badges / Hall of Fame / Red spawn stay as the fallback for a save made before it watched anything",
      "installed mid-run, a rival fight already behind you is written off when it is at or below what you have cleared AND below everything the mod watched fall; nothing is stored, so the answer is re-derived from the save in hand rather than seeded at a boot moment that may not have the save yet",
      "an install landing between two rungs holds the cap for one more boss and then heals itself -- the price of never guessing wrong on a run the mod followed from the start, where level order is not play order (the Goldenrod Underground rival tops at 32 and is fought after Jasmine's 35)",
      "the Cherrygrove rival is the only milestone with a bonus (+2): his roster is one level-5 starter and a strict reading would cap the opening of the game at 5",
      "the sub-50 Kanto gyms are deliberately not milestones -- Janine tops at 39 and Blaine at 50, so they could only pull a post-league cap back down; their badges still open Viridian",
      "ALLOW OVER LVL is Gen 1 only: Gold's World:startBattle constructs and pushes in one call, so there is no factory to wrap. The row says so and stays off",
      "UP TO CAP is Gen 1 only: Gold has no BattleState.StatBox, no move-learn screen outside battle (its four-move prompt is a battle emission its own battle screen consumes) and different fields on the mon, so the entry is not offered there",
      "Gold's Elite Four has no rematch rosters (one team per boss class), so re-clearing the league moves no cap",
    },
  },
  credits = {
    { who = "pret/pokered", for_ = "the trainer rosters and victory flags the caps are derived from" },
  },
  compat = { engine = ">=1.0.0 <2.0.0", modApi = 2 },
}
